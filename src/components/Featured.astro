---
/**
 * Trusted-by marks. Set `logo` to an imported src/assets image to show that
 * company's mark; leave it unset to fall back to the plain wordmark. Set
 * `link` to the client's website to make the logo clickable; leave it unset
 * for no link. `scale` nudges marks whose artwork sits small in its canvas.
 */
import { Image } from "astro:assets";
import sadhooLogo from "../assets/logo/clients/sadhoo.svg";
import kruzzLogo from "../assets/logo/clients/krruz.svg";
import vrittiVogueLogo from "../assets/logo/clients/vritti-vogue.svg";
import beeroLogo from "../assets/logo/clients/beero.jpeg";
import ritualLogo from "../assets/logo/clients/ritual.jpeg";
import yksLogo from "../assets/logo/clients/yks.png";
import woodyTalesLogo from "../assets/logo/clients/woody-tales.png";
import nexgenLogo from "../assets/logo/clients/nexgen.png";

const logos = [
  {
    name: "Vritti Vogue",
    logo: vrittiVogueLogo,
    link: "https://vrittivogue.com/",
    scale: 1,
  },
  { name: "Beero", logo: beeroLogo, scale: 1.05 },
  {
    name: "Woody Tales",
    logo: woodyTalesLogo,
    link: "https://www.woodytales.in/",
    scale: 1.35,
  },
  { name: "Teakmont" },
  { name: "Krruz", logo: kruzzLogo, scale: 0.88 },
  {
    name: "YKS Ventures",
    logo: yksLogo,
    link: "https://www.yksventures.com/",
    scale: 1.6,
  },
  { name: "Sadhoo", logo: sadhooLogo, scale: 1.1 },
  { name: "Ritual", logo: ritualLogo, scale: 1.35 },
  {
    name: "Nexgen Club",
    logo: nexgenLogo,
    link: "https://nexgenclub.in",
    scale: 1,
  },
];
---

<section id="featured" data-screen-label="Featured">
  <div class="feat-top">
    <span class="kicker reveal">// Trusted by</span>
  </div>
  <div class="feat-marquee reveal" data-d="1" aria-label="Trusted by">
    {
      /* Second track is the visual duplicate that makes the marquee loop. It is
         aria-hidden, so its links must also be removed from the tab order. */
      [false, true].map((clone) => (
        <div class="feat-track" aria-hidden={clone ? "true" : undefined}>
          {logos.map((l) => {
            const Tag = l.link ? "a" : "span";
            const linkProps = l.link
              ? {
                  href: l.link,
                  target: "_blank",
                  rel: "noopener noreferrer",
                  tabindex: clone ? -1 : undefined,
                }
              : {};
            return (
              <Tag
                class={l.logo ? "feat-logo" : "feat-logo is-wordmark"}
                title={l.name}
                {...linkProps}
              >
                {l.logo ? (
                  <Image
                    src={l.logo}
                    alt={clone ? "" : `${l.name} logo`}
                    width={360}
                    loading="eager"
                    style={l.scale ? `transform: scale(${l.scale})` : undefined}
                  />
                ) : (
                  l.name
                )}
              </Tag>
            );
          })}
        </div>
      ))
    }
  </div>
</section>
