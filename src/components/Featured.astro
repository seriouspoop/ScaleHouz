---
/**
 * Trusted-by wordmarks. Set `logo` to an imported src/assets image to enable
 * the hover-popup mark for that company; leave it unset to keep the
 * wordmark plain (no popup). Set `link` to the client's website to make the
 * logo clickable; leave it unset for no link.
 */
import { Image } from "astro:assets";
import sadhooLogo from "../assets/logo/clients/sadhoo.svg";
import kruzzLogo from "../assets/logo/clients/krruz.svg";
import vrittiVogueLogo from "../assets/logo/clients/vritti-vogue.svg";
import beeroLogo from "../assets/logo/clients/beero.jpeg";
import ritualLogo from "../assets/logo/clients/ritual.jpeg";
import yksLogo from "../assets/logo/clients/yks.png";
import woodyTalesLogo from "../assets/logo/clients/woody-tales.png";

const logos = [
  {
    name: "Vritti Vogue",
    logo: vrittiVogueLogo,
    link: "https://vrittivogue.com/",
  },
  { name: "Beero", logo: beeroLogo },
  { name: "Woody Tales", logo: woodyTalesLogo, link: "https://www.woodytales.in/" },
  { name: "Teakmont" },
  { name: "Krruz", logo: kruzzLogo },
  {
    name: "YKS Ventures",
    logo: yksLogo,
    link: "https://www.yksventures.com/",
    scale: 1.8,
  },
  { name: "Sadhoo", logo: sadhooLogo },
  { name: "Ritual", logo: ritualLogo },
];
---

<section id="featured" data-screen-label="Featured">
  <div class="feat-top">
    <span class="kicker reveal">// Trusted by</span>
  </div>
  <div class="feat-marquee reveal" data-d="1" aria-label="Trusted by">
    <div class="feat-track">
      {
        logos.map((l) => {
          const Tag = l.link ? "a" : "span";
          const linkProps = l.link
            ? { href: l.link, target: "_blank", rel: "noopener noreferrer" }
            : {};
          return (
            <Tag class="feat-logo" {...linkProps}>
              {l.logo && (
                <span class="fl-pop">
                  <Image
                    src={l.logo}
                    alt={`${l.name} logo`}
                    width={360}
                    loading="eager"
                    style={l.scale ? `transform: scale(${l.scale})` : undefined}
                  />
                </span>
              )}
              {l.name}
            </Tag>
          );
        })
      }
    </div>
    <div class="feat-track" aria-hidden="true">
      {
        logos.map((l) => {
          const Tag = l.link ? "a" : "span";
          const linkProps = l.link
            ? { href: l.link, target: "_blank", rel: "noopener noreferrer" }
            : {};
          return (
            <Tag class="feat-logo" {...linkProps}>
              {l.logo && (
                <span class="fl-pop">
                  <Image
                    src={l.logo}
                    alt={`${l.name} logo`}
                    width={360}
                    loading="eager"
                    style={l.scale ? `transform: scale(${l.scale})` : undefined}
                  />
                </span>
              )}
              {l.name}
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>
