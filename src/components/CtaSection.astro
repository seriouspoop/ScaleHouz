---
/** Closing CTA → isolated onboarding route. Button is magnetic (site.js). */
---

<section id="cta" data-screen-label="Work With Us">
  <div class="sec-orb" id="c-orb-a" aria-hidden="true"></div>
  <div class="sec-orb" id="c-orb-b" aria-hidden="true"></div>
  <div class="sec-orb" id="c-orb-c" aria-hidden="true"></div>
  <div class="cta-status reveal morph"><span class="dot" aria-hidden="true"></span>2 spots left for August — closing soon</div>
  <span class="kicker reveal morph" data-d="1">// Work with us</span>
  <h2 class="reveal morph" data-d="2" id="cta-headline">
    Your growth, in thoughtful hands.
  </h2>
  <p class="reveal morph" data-d="3">
    One conversation is enough to know if we fit. Real conversations, real
    solutions — we reply within a day.
  </p>
  <div id="magnet-zone" class="reveal morph" data-d="3">
    <a class="btn-primary" id="magnet" href="/onboarding" data-cursor
      >START A PROJECT</a
    >
  </div>
  <div class="cta-chips reveal morph" data-d="4">
    <span>Reply within 24 hours</span>
    <span>Free discovery call</span>
    <span>Research before action</span>
  </div>
</section>
