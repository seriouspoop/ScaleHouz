---
/** Vertical "how we work" timeline (site.js drives the spine fill + active-step highlight). */
import { Image } from "astro:assets";
import discoveryImg from "../assets/process/discovery-and-strategy.png";
import designImg from "../assets/process/design-n-prototyping.png";
import buildImg from "../assets/process/build-and-motion.png";
import launchImg from "../assets/process/launch-and-support.png";

const steps = [
  {
    acc: "var(--sh-cyan)",
    wk: "Week 1",
    num: "01",
    h: "Discovery &amp; strategy",
    p: "We analyse your brand and audience to build a solid foundation and a clear plan.",
    img: discoveryImg,
  },
  {
    acc: "var(--sh-amber)",
    wk: "Week 2–3",
    num: "02",
    h: "Design &amp; prototyping",
    p: "We craft the journey and high-fidelity prototypes to test, refine, and approve.",
    img: designImg,
  },
  {
    acc: "var(--sh-yellow)",
    wk: "Week 4–5",
    num: "03",
    h: "Build &amp; motion",
    p: "Pixel-perfect build with smooth interactions, responsive layouts, fast performance.",
    img: buildImg,
  },
  {
    acc: "var(--sh-magenta)",
    wk: "Week 6",
    num: "04",
    h: "Launch &amp; support",
    p: "Rigorous QA, SEO, launch — then we stay close as you grow.",
    dark: true,
    img: launchImg,
  },
];
---

<section id="process" data-screen-label="How We Work">
  <div class="sec-orb" id="p-orb-a" aria-hidden="true"></div>
  <div class="sec-orb" id="p-orb-b" aria-hidden="true"></div>
  <div class="proc-head">
    <div class="sec-head light" style="max-width:640px;margin:0">
      <span class="kicker reveal morph">// How we work</span>
      <h2 class="reveal morph" data-d="1">
        From brief to launch, without the chaos.
      </h2>
    </div>
    <div class="proc-total reveal morph" data-d="2">
      <span class="n">6 weeks</span>
      <span class="l">Typical timeline</span>
    </div>
  </div>
  <ol class="tl" id="proc-tl">
    {
      steps.map((s, i) => (
        <li
          class:list={["tl-step", "reveal", "morph", { dark: s.dark }]}
          data-d={String(i)}
          style={`--acc:${s.acc}`}
        >
          <div class="tl-when">
            <span class="tl-wk">{s.wk}</span>
          </div>
          <div class="tl-mark" aria-hidden="true">
            <span class="tl-dot" />
          </div>
          <div class="tl-card">
            <div class="tl-txt">
              <div class="tl-top">
                <span class="tl-num">{s.num}</span>
                <h3 set:html={s.h} />
              </div>
              <p>{s.p}</p>
            </div>
            <div class="tl-shot">
              <Image
                src={s.img}
                alt={s.h.replace(/&amp;/g, "&")}
                class="tl-img"
                width={540}
                loading="lazy"
              />
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>
