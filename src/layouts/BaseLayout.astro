---
/**
 * BaseLayout — shared <head>, SEO meta, and design tokens for every page.
 * Keeps baseline HTML lightweight for low TTFB on the Cloudflare edge.
 */
import '../styles/tokens.css';

export interface Props {
  title: string;
  description: string;
  /** Absolute path of this page, used for canonical + og:url */
  path?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  path = '/',
  bodyClass,
} = Astro.props;

const siteName = 'Scale Houz';
const canonical = new URL(path, Astro.site ?? 'https://scalehouz.com').href;
const site = Astro.site ?? 'https://scalehouz.com';
const ogImage = new URL('/assets/logo/scale-houz-logo-on-black.png', site).href;
const ogImageSquare = new URL('/assets/logo/scale-houz-logo-square.png', site).href;
const imageAlt = `${siteName} — every design to scale`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: new URL('/', site).href,
  logo: {
    '@type': 'ImageObject',
    url: ogImageSquare,
    width: 1200,
    height: 1200,
  },
  image: ogImage,
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Order matters: Chromium uses the LAST rel="icon", so the legacy .ico
       goes first and the SVG last. -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
  <!-- Solid-background raster icons: Google Search results and iOS home screen.
       Google weights apple-touch-icon and 48px multiples most heavily. Kept
       before the SVG so the tab still gets the transparent mark. -->
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192x192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/icon-512x512.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#000000" />

  <!-- Open Graph / social -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <!-- Primary: 1.91:1 landscape card (LinkedIn, Facebook, Slack, Discord, Telegram) -->
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <!-- Fallback: 1:1 square for consumers that prefer a small thumbnail (WhatsApp, iMessage) -->
  <meta property="og:image" content={ogImageSquare} />
  <meta property="og:image:secure_url" content={ogImageSquare} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="1200" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={imageAlt} />

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <slot name="head" />
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
